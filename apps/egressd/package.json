{
  "name": "@egresskit/egressd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyjunpenn/EgressKit.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "bin": {
    "egresskit": "dist/control-cli-bin.js",
    "egressd": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json --noEmit false --outDir dist",
    "check": "pnpm typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm run build && node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.20.5"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}

{
  "name": "egresskit",
  "version": "0.0.0",
  "private": true,
  "description": "One proxy endpoint, many managed exits.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "turbo run build",
